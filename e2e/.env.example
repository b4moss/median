# Copy to .env or export before running E2E.
MEDIAN_E2E_S3_ACCESS_KEY=median_e2e
MEDIAN_E2E_S3_SECRET_KEY=median_e2e_secret
MEDIAN_E2E_S3_BUCKET=median-e2e
MEDIAN_E2E_S3_REGION=us-east-1
# Host-side endpoint when RustFS is published on localhost.
MEDIAN_E2E_S3_ENDPOINT=http://127.0.0.1:9000
# Inside compose network use http://rustfs:9000
# Local adapter root inside runner containers:
MEDIAN_E2E_LOCAL_ROOT=/data/local
