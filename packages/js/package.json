{
  "name": "@b4moss/median",
  "version": "0.9.0",
  "description": "Median media store (TypeScript) — Store/Delete/Get/PresignGet with local/S3, DB, image pipeline, SVG sanitize, PDF thumbnails",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "median": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/median.git",
    "directory": "packages/js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@b4moss/shardian": "^0.4.0",
    "better-sqlite3": "^11.8.1",
    "sharp": "^0.35.4",
    "svgo": "^3.3.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "c8": "^10.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
