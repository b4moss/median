// median default media ER (logical)
// docs/er.dbml — design ER; physical DDL is produced by dialect-aware goose migrations under /migrations.
// Default id strategy is auto increment → integer (serial/bigserial 相当).
// UUID v4 / UUID v7 / ULID 選択時は id / original_id を text にする。
// Dialects (crudian-aligned): MySQL, MariaDB, Postgres, SQLite.
// Migration source of truth: /migrations (Go uses goose; one definition, dialect interprets).
// DB ops via b4moss/crudian. path is relative to storage root only (no storage key).

Table media {
  id bigint [pk, increment, note: 'DB使用時の正キー。デフォルト採番 auto increment 時は integer/bigint。UUID v4/v7/ULID 時は text']
  path varchar(2048) [not null, unique, note: 'ストレージルートからの相対パス。storage key は持たない。preserve時は危険文字と端の . / 空白を除去']
  mime varchar(255) [not null]
  size bigint [not null, note: 'バイトサイズ']
  hash char(64) [note: 'SHA-256 hex。重複抑止に使用']
  original_id bigint [note: 'NULLならオリジナル。派生は親を参照。型は id に合わせる（デフォルト integer、UUID/ULID 時は text）']
  created_by varchar(255) [note: '作成者識別子。Store時は owned_by と同値。未指定時は default actor']
  owned_by varchar(255) [note: '所有者識別子。Store時は created_by と同値。未指定時は default actor']
  status text [not null, default: 'active', note: 'アプリ側の状態。median Delete は物理削除（論理削除は当面スコープ外）']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    hash
    original_id
    (owned_by, status)
    created_at
  }
}

Ref: media.original_id > media.id
